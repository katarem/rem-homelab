# ===========================================================================
# Sure (finance) - environment variables for compose.yml
# Copy to .env and fill in the values: cp .env.example .env
# ===========================================================================

# --- General ---------------------------------------------------------------
# Host port for the web UI (container listens on 3000)
PORT=3330
SURE_IMAGE_TAG=stable

# --- Database --------------------------------------------------------------
POSTGRES_USER=sure_user
# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=
POSTGRES_DB=sure_production

# --- Rails secrets ---------------------------------------------------------
# REQUIRED. Generate with: openssl rand -hex 64
# Existing install: reuse the current value, never regenerate it.
SECRET_KEY_BASE=

# Optional but recommended. Set all three or none.
# Generate with: docker compose run --rm web bin/rails db:encryption:init
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# --- Background jobs -------------------------------------------------------
# Seconds a missed scheduled job may run late (default 600)
SIDEKIQ_CRON_GRACE_PERIOD_SECONDS=

# --- AI (optional) ---------------------------------------------------------
# Leave empty to disable AI features. OpenAI usage incurs costs.
OPENAI_ACCESS_TOKEN=
OPENAI_MODEL=
# Set to use an OpenAI-compatible endpoint (e.g. the local Ollama in ai/)
OPENAI_URI_BASE=
LLM_CONTEXT_WINDOW=
OPENAI_REQUEST_TIMEOUT=60
AI_HEALTH_PROBE_TIMEOUT=
AI_HEALTH_PROBE_CACHE_TTL=
AI_RESPONSE_TIMEOUT=90
ASSISTANT_MAX_TOOL_CALL_ITERATIONS=

# --- Backups (profile: backup) ---------------------------------------------
BACKUP_DIR=./backups
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_KEEP_DAYS=7
INSTANCE_ID=default

# --- Offsite backups (profile: backup-offsite) -----------------------------
# rclone remote, e.g. s3:my-bucket/sure
BACKUP_DESTINATION=
RCLONE_CONFIG_S3_TYPE=s3
RCLONE_CONFIG_S3_PROVIDER=
RCLONE_CONFIG_S3_ACCESS_KEY_ID=
RCLONE_CONFIG_S3_SECRET_ACCESS_KEY=
RCLONE_CONFIG_S3_ENDPOINT=